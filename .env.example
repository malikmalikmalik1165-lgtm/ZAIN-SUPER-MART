# ZAIN SUPER MART - Environment Configuration
# =============================================
# Copy to .env and fill in actual values

# Local Database (sandbox only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase (ZAIN SUPER MART dedicated project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin Authentication (server-side only)
ZSM_ADMIN_USERNAME=your-admin-username
ZSM_ADMIN_PASSWORD=your-admin-password
ZSM_SESSION_SECRET=your-random-secret-at-least-32-chars

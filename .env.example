# ZAIN SUPER MART - Environment Configuration Example
# ====================================================
# Copy this file to .env and fill in the actual values

# Local Database (Sandbox PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase Configuration (for database access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Authentication (server-side only - NEVER use NEXT_PUBLIC_ prefix)
ZSM_ADMIN_USERNAME=your-admin-username
ZSM_ADMIN_PASSWORD=your-admin-password
ZSM_SESSION_SECRET=your-random-session-secret-at-least-32-chars
